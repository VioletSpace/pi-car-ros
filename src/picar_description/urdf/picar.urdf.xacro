<?xml version="1.0"?>
<robot name="picar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- test tf tree -->
  <!-- base link -->
  <link name="base_link"/>

  <!-- rear wheels -->
  <link name="rear_left_wheel"/>
  <link name="rear_right_wheel"/>

  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- steering axle -->
  <link name="front_axle_link"/>

  <joint name="steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_axle_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="1" velocity="1"/>
  </joint>

  <!-- front wheels attached to steering axle -->
  <link name="front_left_wheel"/>
  <link name="front_right_wheel"/>

  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_axle_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0 0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_axle_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0 -0.1 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>