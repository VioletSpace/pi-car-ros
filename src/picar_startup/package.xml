<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>picar_startup</name>
  <version>0.1.0</version>
  <description>ROS 2 bringup package for Pi-Car</description>
  <maintainer email="johanna.pluschke.ext@ptb.de">Johanna Pluschke</maintainer>
  <license>Apache-2.0</license>
  <author>Johanna Pluschke</author>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_hat_driver</exec_depend>
  <exec_depend>picar_description</exec_depend>
  <exec_depend>picar_controller</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
