[Unit]
Description=PiCar robot ROS2 startup service
After=network-online.target systemd-udev-settle.service
Wants=network-online.target systemd-udev-settle.service
# Wait for hardware devices (USB, I2C, GPIO)
# Adjust paths depending on your hardware
# Requires=sys-devices-platform-serial8250-tty-ttyUSB0.device

[Service]
Type=simple
User=ex123
WorkingDirectory=/home/ex123
# Wait for hardware to settle before starting ROS
ExecStartPre=/bin/sleep 10 # hope and pray that GPIO is ready at this point
# ROS 2 environment + launch
ExecStart=/bin/bash -c 'source /opt/ros/kilted/setup.bash && \
source /home/ex123/ros2_ws/install/setup.bash && \
exec ros2 launch picar_startup bringup.launch'

# Auto-restart
Restart=always
RestartSec=2
StartLimitIntervalSec=0
# Keep logs persistent
StandardOutput=append:/home/ex123/robot.log
StandardError=append:/home/ex123/robot_error.log
# Safety: give hardware time to release
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target